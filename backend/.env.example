AI_PROVIDER=groq
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=
AI_VISION_MODEL=
AI_API_KEY=
API_TOKEN=
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=instance/emergencycore.sqlite3

LOCAL_MODEL_ENABLED=true
GEO_DATA_DIR=data
# Optional backend-relative JSON file with custom study-region definitions.
REGIONS_FILE=
ALASKA_511_API_KEY=
# Identify the application; adding a real project URL/contact is recommended by NWS.
NWS_USER_AGENT=EmergencyCore-local-prototype
INGEST_INTERVAL_SECONDS=300


# Primary: Groq; backup: Gemini. Existing legacy AI_API_KEY is not used in groq mode.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
AI_FALLBACK_ENABLED=true
AI_MAX_OUTPUT_TOKENS=4096

# Neon injects these into root .env.local; configure both in Render secrets.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
